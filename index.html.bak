                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </button>
            </div>

            <div class="project-mockup-wrap">
              <img src="assets/images/notetaking_app.jpg" alt="Voice-to-Notes Mobile App UI Mockup" loading="lazy">
              <div class="project-mockup-overlay">
                <span class="mockup-zoom-badge">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    <line x1="11" y1="8" x2="11" y2="14"></line>
                    <line x1="8" y1="11" x2="14" y2="11"></line>
                  </svg>
                  Explore Case Study
                </span>
              </div>
            </div>
          </article>

          <!-- PROJECT 04: VOCABULARY APP -->
          <article class="project-card reverse-layout reveal-init" data-project-id="4">
            <div class="project-info">
              <div class="project-header-meta">
                <span class="project-number">04</span>
                <span class="project-category">Language Learning · Mobile App</span>
              </div>
              <h3 class="project-title">VOCABULARY APP</h3>
              <p class="project-description">
                Designed a dedicated language-learning application focused on building vocabulary through interactive
                learning features and structured practice.
              </p>
              <div class="project-tags">
                <span class="project-tag">Vocabulary Cards</span>
                <span class="project-tag">Interactive Practice</span>
                <span class="project-tag">Progress Rings</span>
                <span class="project-tag">Learning Screens</span>
              </div>
              <button class="btn btn-secondary view-case-study-btn" aria-label="View Vocabulary App Case Study">
                <span>View Case Study</span>
                <svg class="arrow-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                  stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </button>
            </div>

            <div class="project-mockup-wrap">
              <img src="assets/images/vocabulary_app.jpg" alt="Language Learning Vocabulary Mobile App UI Mockup"
                loading="lazy">
              <div class="project-mockup-overlay">
                <span class="mockup-zoom-badge">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    <line x1="11" y1="8" x2="11" y2="14"></line>
                    <line x1="8" y1="11" x2="14" y2="11"></line>
                  </svg>
                  Explore Case Study
                </span>
              </div>
            </div>
          </article>

          <!-- PROJECT 05: RAYFOOD -->
          <article class="project-card reveal-init" data-project-id="5">
            <div class="project-info">
              <div class="project-header-meta">
                <span class="project-number">05</span>
                <span class="project-category">Food Delivery · Mobile App</span>
              </div>
              <h3 class="project-title">RAYFOOD</h3>
              <p class="project-description">
                Designed a modern food delivery and restaurant discovery mobile application featuring live order
                tracking,
                customizable meal modifiers, and seamless checkout.
              </p>
              <div class="project-tags">
                <span class="project-tag">Restaurant Discovery</span>
                <span class="project-tag">Menu Customization</span>
                <span class="project-tag">Live Order Tracking</span>
                <span class="project-tag">Cart &amp; Checkout</span>
              </div>
              <button class="btn btn-secondary view-case-study-btn" aria-label="View Rayfood Case Study">
                <span>View Case Study</span>
                <svg class="arrow-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                  stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </button>
            </div>

            <div class="project-mockup-wrap">
              <img src="assets/images/rayfood_app.jpg" alt="Rayfood Food Delivery Mobile App UI Mockup" loading="lazy">
              <div class="project-mockup-overlay">
                <span class="mockup-zoom-badge">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    <line x1="11" y1="8" x2="11" y2="14"></line>
                    <line x1="8" y1="11" x2="14" y2="11"></line>
                  </svg>
                  Explore Case Study
                </span>
              </div>
            </div>
          </article>

          <!-- PROJECT 06: MARKETPLACE WEBSITE -->
          <article class="project-card reverse-layout reveal-init" data-project-id="6">
            <div class="project-info">
              <div class="project-header-meta">
                <span class="project-number">06</span>
                <span class="project-category">Marketplace · Web</span>
              </div>
              <h3 class="project-title">MARKETPLACE WEBSITE</h3>
              <p class="project-description">
                Designed a buy-and-sell platform inspired by OLX, including search filters, product listings, chat, user
                profiles, wireframes and interactive prototypes.
              </p>
              <div class="project-tags">
                <span class="project-tag">Search &amp; Filters</span>
                <span class="project-tag">Product Listings</span>
                <span class="project-tag">Seller Profile</span>
