<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Bisma Mushtaq — UI/UX Designer</title>
  <meta name="description"
    content="Portfolio of Bisma Mushtaq, a UI/UX Designer with 3+ years of experience designing intuitive, responsive, and user-centered digital products.">
  <meta name="keywords"
    content="Bisma Mushtaq, UI/UX Designer, Product Designer, Web Design, Mobile App Design, Wireframing, Figma, Framer">
  <meta name="author" content="Bisma Mushtaq">

  <!-- Open Graph / Meta -->
  <meta property="og:type" content="website">
  <meta property="og:title" content="Bisma Mushtaq — UI/UX Designer">
  <meta property="og:description" content="Designing digital experiences that feel simple, intuitive and meaningful.">
  <meta property="og:image" content="assets/images/bisma_hero.jpg">
  <meta name="twitter:card" content="summary_large_image">

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml"
    href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='%23B8FF3D'><circle cx='12' cy='12' r='10'/></svg>">

  <!-- Stylesheets -->
  <link rel="stylesheet" href="css/style.css">
  <link rel="stylesheet" href="css/components.css">
  <link rel="stylesheet" href="css/animations.css">
</head>

<body>

  <!-- ===================================================
       1. FLOATING NAVBAR
       =================================================== -->
  <header class="navbar-wrapper">
    <nav class="navbar" id="mainNavbar" aria-label="Main Navigation">
      <a href="#" class="nav-brand" aria-label="Bisma Mushtaq Home">
        <span>BISMA</span>
        <span class="brand-dot"></span>
      </a>

      <div class="nav-links">
        <a href="#work" class="nav-link">Work</a>
        <a href="#about" class="nav-link">About</a>
        <a href="#experience" class="nav-link">Experience</a>
        <a href="#services" class="nav-link">Services</a>
      </div>

      <div class="nav-cta">
        <a href="#contact-modal" class="btn btn-primary open-contact-modal">
          <span>Let's Talk</span>
          <svg class="arrow-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
            stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>

      <!-- Mobile Hamburger Toggle -->
      <button class="nav-mobile-toggle" id="mobileNavToggle" aria-label="Open Navigation Menu">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
          stroke-linecap="round" stroke-linejoin="round">
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
    </nav>
  </header>

  <!-- Fullscreen Mobile Navigation Overlay -->
  <div class="mobile-nav-overlay" id="mobileNavOverlay">
    <button class="mobile-nav-close" id="mobileNavClose" aria-label="Close Navigation Menu">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
        stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>

    <div class="mobile-nav-links">
      <a href="#work" class="mobile-nav-link">
        <span>Work</span>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
          stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
      <a href="#about" class="mobile-nav-link">
        <span>About</span>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
          stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
      <a href="#experience" class="mobile-nav-link">
        <span>Experience</span>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
          stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
      <a href="#services" class="mobile-nav-link">
        <span>Services</span>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
          stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
      <a href="#contact-modal" class="mobile-nav-link open-contact-modal">
        <span>Let's Talk</span>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
          stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>

    <div class="mobile-nav-footer">
      <p style="color: var(--text-light-muted); font-size: 0.875rem;">Get in touch directly</p>
      <a href="mailto:bismahbhat007@gmail.com"
        style="color: var(--accent-lime); font-weight: 600; font-size: 1.1rem;">bismahbhat007@gmail.com</a>
    </div>
  </div>

  <main>
    <!-- ===================================================
         2. HERO SECTION
         =================================================== -->
    <section class="hero-section" id="hero">
      <div class="container">
        <div class="hero-grid">

          <div class="hero-content reveal-init">
            <div class="hero-meta-row">
              <span class="section-label">
                <span class="dot"></span>
                UI/UX DESIGNER
              </span>

              <div class="status-pill">
                <span class="status-indicator"></span>
                <span>Available for new opportunities</span>
              </div>
            </div>

            <div class="hero-greeting">Hi, I'm Bisma.</div>

            <h1 class="hero-headline">
              I design digital experiences that feel <span class="editorial-italic">simple &amp; meaningful.</span>
            </h1>

            <p class="hero-description">
              Creative and detail-oriented UI/UX Designer with 3+ years of experience building intuitive, responsive,
              and user-focused digital products.
            </p>

            <div class="hero-actions">
              <a href="#work" class="btn btn-primary">
                <span>View My Work</span>
                <svg class="arrow-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                  stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="12" y1="5" x2="12" y2="19"></line>
                  <polyline points="19 12 12 19 5 12"></polyline>
                </svg>
              </a>

              <button class="btn btn-secondary open-resume-modal" aria-label="Open Bisma Mushtaq Resume Preview">
                <span>View Resume</span>
                <svg class="arrow-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                  stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                  <polyline points="14 2 14 8 20 8"></polyline>
                  <line x1="16" y1="13" x2="8" y2="13"></line>
                  <line x1="16" y1="17" x2="8" y2="17"></line>
                  <polyline points="10 9 9 9 8 9"></polyline>
                </svg>
              </button>
            </div>

            <div class="hero-statement-card">
              <div class="statement-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#111111" stroke-width="2.5"
                  stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
                </svg>
              </div>
              <p>"Creating digital experiences that balance usability, visual quality and business goals."</p>
            </div>
          </div>

          <!-- Hero Image with Editorial Cutout & Glow -->
          <div class="hero-visual reveal-init delay-2">
            <div class="hero-glow-backdrop animate-glow"></div>

            <div class="hero-image-card">
              <div class="hero-image-wrapper">
                <img src="assets/images/bisma_hero.jpg" alt="Bisma Mushtaq - UI/UX Designer" loading="eager">
              </div>

              <div class="hero-floating-badge animate-float">
                <span class="badge-icon">✦</span>
                <span>Crafting Intuitive Interfaces</span>
              </div>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- ===================================================
         3. INTRODUCTION SECTION
         =================================================== -->
    <section class="section intro-section" id="about">
      <div class="container">
        <div class="intro-grid">

          <div class="reveal-init">
            <span class="section-label">
              <span class="dot"></span>
              ABOUT ME
            </span>
            <h2 class="intro-large-statement">
              Designing experiences where usability meets visual clarity.
            </h2>
          </div>

          <div class="intro-details reveal-init delay-2">
            <p>
              Creative and detail-oriented UI/UX Designer with 3+ years of experience building intuitive, responsive,
              and user-focused digital products.
            </p>
            <p>
              Experienced in UI/UX design, responsive interfaces, user research, prototyping, usability testing and
              collaborating with developers and product teams to translate complex business requirements into seamless,
              delightful products.
            </p>

            <div class="skills-pill-group">
              <span class="skill-pill">UI/UX Design</span>
              <span class="skill-pill">Responsive Interfaces</span>
              <span class="skill-pill">User Research</span>
              <span class="skill-pill">Wireframing &amp; Prototyping</span>
              <span class="skill-pill">Usability Testing</span>
              <span class="skill-pill">Design Systems</span>
              <span class="skill-pill">ERP &amp; SaaS Systems</span>
            </div>

            <div style="margin-top: 10px;">
              <a href="#experience" class="btn btn-secondary">
                <span>More About Me</span>
                <svg class="arrow-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                  stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </a>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- ===================================================
         4. SELECTED WORK SECTION (7 PROJECTS)
         =================================================== -->
    <section class="section work-section" id="work">
      <div class="container">

        <div class="section-header reveal-init">
          <span class="section-label">
            <span class="dot"></span>
            MY WORK
          </span>
          <h2 class="section-title">Selected projects I've designed.</h2>
          <p class="section-subtitle">
            A collection of digital products and experiences across marketplaces, consultation, education, productivity
            and responsive web.
          </p>
        </div>

        <div class="projects-container">

          <!-- PROJECT 01: FREELANCE MARKETPLACE PLATFORM -->
          <article class="project-card reveal-init" data-project-id="1">
            <div class="project-info">
              <div class="project-header-meta">
                <span class="project-number">01</span>
                <span class="project-category">Two-Sided Marketplace</span>
              </div>
              <h3 class="project-title">FREELANCE MARKETPLACE</h3>
              <p class="project-description">
                A two-sided digital marketplace connecting clients with skilled freelancers, featuring distinct
                discovery, onboarding, and contract workflows.
              </p>
              <div class="project-tags">
                <span class="project-tag">Two-Sided Platform</span>
                <span class="project-tag">Freelancers &amp; Clients</span>
                <span class="project-tag">Information Architecture</span>
                <span class="project-tag">Hiring Workflows</span>
              </div>
              <p class="new-button">
                <span>View Case Study</span>
                <svg class="arrow-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                  stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </p>
            </div>

            <div class="project-mockup-wrap">
              <img src="assets/images/gig_per_hour.jpg" alt="Freelance Marketplace Platform UI Mockup" loading="lazy">
              <div class="project-mockup-overlay">
                <span class="mockup-zoom-badge">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    <line x1="11" y1="8" x2="11" y2="14"></line>
                    <line x1="8" y1="11" x2="14" y2="11"></line>
                  </svg>
                  Explore Case Study
                </span>
              </div>
            </div>
          </article>

          <!-- PROJECT 02: RAY CONSULTATION -->
          <article class="project-card reverse-layout reveal-init" data-project-id="2">
            <div class="project-info">
              <div class="project-header-meta">
                <span class="project-number">02</span>
                <span class="project-category">Consultation Platform</span>
              </div>
              <h3 class="project-title">RAY CONSULTATION</h3>
              <p class="project-description">
                Designed a consultation platform focused on consultant discovery, profiles and a streamlined user
                experience.
              </p>
              <div class="project-tags">
                <span class="project-tag">Consultant Discovery</span>
                <span class="project-tag">Expert Profiles</span>
                <span class="project-tag">Consultation Flow</span>
                <span class="project-tag">Booking System</span>
              </div>
              <button class="btn btn-secondary view-case-study-btn" aria-label="View Ray Consultation Case Study">
                <span>View Case Study</span>
                <svg class="arrow-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                  stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </button>
            </div>

            <div class="project-mockup-wrap">
              <img src="assets/images/ray_consultation.jpg" alt="Ray Consultation Platform UI Mockup" loading="lazy">
              <div class="project-mockup-overlay">
                <span class="mockup-zoom-badge">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    <line x1="11" y1="8" x2="11" y2="14"></line>
                    <line x1="8" y1="11" x2="14" y2="11"></line>
                  </svg>
                  Explore Case Study
                </span>
              </div>
            </div>
          </article>

          <!-- PROJECT 03: NOTE TAKING APP -->
          <article class="project-card reveal-init" data-project-id="3">
            <div class="project-info">
              <div class="project-header-meta">
                <span class="project-number">03</span>
                <span class="project-category">Voice-to-Notes · Mobile App</span>
              </div>
              <h3 class="project-title">NOTE TAKING APP</h3>
              <p class="project-description">
                Designed a note-taking application that allows users to record voice and automatically generate notes,
                making it easier to capture and organize information.
              </p>
              <div class="project-tags">
                <span class="project-tag">Voice Recording</span>
                <span class="project-tag">Generated Notes</span>
                <span class="project-tag">Notes Organization</span>
                <span class="project-tag">Mobile Navigation</span>
              </div>
              <button class="btn btn-secondary view-case-study-btn" aria-label="View Note Taking App Case Study">
                <span>View Case Study</span>
                <svg class="arrow-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
