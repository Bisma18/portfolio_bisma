          <!-- PROJECT 07: RAYBIT TECHNOLOGIES WEBSITE -->
          <article class="project-card reveal-init" data-project-id="7">
            <div class="project-info">
              <div class="project-header-meta">
                <span class="project-number">07</span>
                <span class="project-category">Corporate Website · UI/UX</span>
