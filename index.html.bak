          style="font-size: clamp(2rem, 3.5vw, 2.8rem); margin-bottom: 24px;">Project Title</h3>

        <div class="modal-meta-grid">
          <div class="modal-meta-item">
            <span>Role</span>
            <strong id="modalRole">Lead UI/UX Designer</strong>
          </div>
          <div class="modal-meta-item">
            <span>Timeline</span>
            <strong id="modalTimeline">3 Months</strong>
          </div>
          <div class="modal-meta-item">
            <span>Tools</span>
            <strong id="modalTools">Figma, Framer</strong>
          </div>
          <div class="modal-meta-item">
            <span>Client</span>
            <strong id="modalClient">Platform</strong>
          </div>
        </div>

        <h4 class="modal-section-title">Project Overview</h4>
        <p class="modal-text" id="modalOverview"></p>

        <h4 class="modal-section-title">Design Challenge</h4>
        <p class="modal-text" id="modalChallenge"></p>

        <h4 class="modal-section-title">Key UX Solutions</h4>
        <div class="modal-highlights-grid" id="modalSolutionsGrid"></div>

        <h4 class="modal-section-title">Key Features &amp; Deliverables</h4>
        <ul class="timeline-duties" id="modalFeaturesList" style="margin-top: 16px;"></ul>

      </div>

    </div>
  </div>

  <!-- ===================================================
       13B. LET'S TALK INTERACTIVE CONTACT CARD MODAL
       =================================================== -->
  <div class="modal-backdrop" id="contactModal" role="dialog" aria-modal="true" aria-labelledby="contactModalTitle">
    <div class="contact-modal-container">

      <div class="contact-modal-header">
        <div class="contact-modal-header-text">
          <span class="section-label" style="margin-bottom: 8px;">
            <span class="dot"></span>
            LET'S TALK
          </span>
          <h3 id="contactModalTitle">Start a Conversation</h3>
          <p>Tell me about your project, timeline, and vision.</p>
        </div>
        <button class="modal-close-btn" id="contactModalCloseBtn" aria-label="Close contact modal">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
            stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>

      <div class="contact-modal-body">

        <!-- Contact Form -->
        <form class="contact-form" id="contactForm" action="https://formsubmit.co/bismahbhat007@gmail.com"
          method="POST">
          <input type="hidden" name="service" id="selectedServiceInput" value="UI/UX Design">
          <input type="hidden" name="_captcha" value="false">
          <input type="hidden" name="_template" value="table">

          <div class="form-group-row">
            <div class="form-group">
              <label for="contactName">Your Name</label>
              <input type="text" name="name" id="contactName" class="form-input" placeholder="e.g. Alex Morgan"
                required>
            </div>
            <div class="form-group">
              <label for="contactEmail">Your Email</label>
              <input type="email" name="email" id="contactEmail" class="form-input" placeholder="e.g. alex@company.com"
                required>
            </div>
          </div>

          <div class="form-group">
            <label>What are you looking to design?</label>
            <div class="chip-select-group">
              <button type="button" class="project-chip-btn active" data-service="UI/UX Design">UI/UX Design</button>
              <button type="button" class="project-chip-btn" data-service="Web Design">Web Design</button>
              <button type="button" class="project-chip-btn" data-service="Mobile App">Mobile App</button>
              <button type="button" class="project-chip-btn" data-service="ERP &amp; SaaS">ERP &amp; SaaS</button>
              <button type="button" class="project-chip-btn" data-service="Design System">Design System</button>
              <button type="button" class="project-chip-btn" data-service="Wireframing">Wireframing</button>
            </div>
          </div>

          <div class="form-group">
            <label for="contactMessage">Project Details &amp; Goals</label>
            <textarea name="message" id="contactMessage" class="form-textarea"
              placeholder="Briefly describe what you're building, target timeline, or any key requirements..."
              required></textarea>
          </div>

          <button type="submit" class="btn btn-lime-glow contact-submit-btn">
            <span>Send Message</span>
            <svg class="arrow-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
              stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </button>
        </form>

        <!-- Success Screen State -->
        <div class="contact-success-screen" id="contactSuccessScreen">
          <div class="success-icon-badge">
            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"
              stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </div>
          <h4>Message Received!</h4>
          <p id="successUserEmail">Thank you for reaching out. I'll review your project details and get back to you
            within 24 hours.</p>
          <button type="button" class="btn btn-secondary" id="contactResetBtn">
            <span>Send Another Note</span>
          </button>
        </div>

      </div>

    </div>
  </div>

